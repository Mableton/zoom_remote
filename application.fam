# Manifest der Zoom-Fernbedienung
App(
    appid="zoom_remote",
    name="Zoom Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="zoom_remote_app",
    stack_size=4 * 1024,
    fap_category="Tools",
    fap_version="1.0",
    fap_icon="zoom_remote.png",  # 10x10 1-Bit PNG
    fap_icon_assets="images",  # Icons für die Views
    fap_libs=["ble_profile"],  # Bluetooth-HID-Profil
    fap_description="Remote control for Zoom Workplace on macOS and Windows via USB or Bluetooth HID",
    fap_weburl="https://github.com/Mableton/zoom_remote",
    fap_author="Manoah Ruiz Rodriguez",
)
